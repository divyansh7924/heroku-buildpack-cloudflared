#!/bin/sh

build_dir=$1
env_dir=$3
working_dir=`pwd`

# --- Download latest cloudflared for Linux amd64 ---
mkdir -p $build_dir/vendor
cd $build_dir/vendor
echo "Downloading cloudflared..."
CLOUDFLARED_URL=$(curl -s https://api.github.com/repos/cloudflare/cloudflared/releases/latest \
  | grep browser_download_url \
  | grep linux-amd64 \
  | cut -d '"' -f 4)

wget -q $CLOUDFLARED_URL -O cloudflared.tgz
tar -xzf cloudflared.tgz
chmod +x cloudflared
rm cloudflared.tgz

# --- Add cloudflared to PATH ---
mkdir -p $build_dir/.profile.d
echo 'PATH=$PATH:$HOME/vendor' > $build_dir/.profile.d/cloudflared.sh
