#!/bin/sh

build_dir=$1
env_dir=$3
working_dir=`pwd`

echo "=== Installing cloudflared ==="

# Create vendor directory
mkdir -p $build_dir/vendor

# Get latest cloudflared release
LATEST=$(curl -s https://api.github.com/repos/cloudflare/cloudflared/releases/latest \
  | grep '"tag_name":' | sed -E 's/.*"([^"]+)".*/\1/')

echo "Latest cloudflared version: $LATEST"

# Download standalone binary
wget -q -O $build_dir/vendor/cloudflared https://github.com/cloudflare/cloudflared/releases/download/$LATEST/cloudflared-linux-amd64

# Make it executable
chmod +x $build_dir/vendor/cloudflared

# Add cloudflared to PATH
mkdir -p $build_dir/.profile.d
echo 'export PATH=$PATH:$HOME/vendor' > $build_dir/.profile.d/cloudflared.sh
